// mdo3d-utilities — shared by all mdothree tools (hash, password, color, timestamp,
// json, pdf, qr, text, image) and the mdothree.com landing.
// This is the COMPLETE ruleset for the project. Keep it byte-identical with
// projects/mdothree/mdothree-api/firestore.rules (shared/rules-tests checks both).
//
// State of the clients (2026-10-07): every tool keeps history, palettes, presets and
// favourites in localStorage only. The ONLY client Firestore access is reading the
// caller's own subscriptions/{uid} doc. Everything else is server-only (Cloud
// Functions Admin SDK) or legacy data the owner may still read/delete.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // Stripe subscriptions: written exclusively by the webhook / createSetupIntent
    // (Admin SDK). Clients read their own doc to check Pro; nobody can self-grant.
    match /subscriptions/{uid} {
      allow read:  if isOwner(uid);
      allow write: if false;
    }

    // Per-user profile doc: no client writes it; read-only so no one can set
    // isPremium/plan-like fields on themselves.
    match /users/{userId} {
      allow read:  if isOwner(userId);
      allow write: if false;
    }

    // ── Legacy client-written collections (no longer written by any client) ──
    // Creates are denied (they held raw tool input: passwords, hashes, timestamps,
    // palettes). Owners may still read and delete what was stored earlier.
    match /history/{docId}               { allow read, delete: if isOwner(resource.data.uid); allow create, update: if false; }
    match /hash_history/{docId}          { allow read, delete: if isOwner(resource.data.uid); allow create, update: if false; }
    match /hash_favourites/{docId}       { allow read, delete: if isOwner(resource.data.uid); allow create, update: if false; }
    match /password_history/{docId}      { allow read, delete: if isOwner(resource.data.uid); allow create, update: if false; }
    match /color_palettes/{docId}        { allow read, delete: if isOwner(resource.data.uid); allow create, update: if false; }
    match /timestamp_conversions/{docId} { allow read, delete: if isOwner(resource.data.uid); allow create, update: if false; }
    match /timestamp_presets/{docId}     { allow read, delete: if isOwner(resource.data.uid); allow create, update: if false; }
    match /color_recents/{uid}           { allow read, delete: if isOwner(uid);               allow create, update: if false; }

    // ── Server-only ──
    match /portal_sessions/{sessionId} { allow read, write: if false; }
    match /analytics_events/{docId}    { allow read, write: if false; }
    match /analytics_daily/{docId}     { allow read, write: if false; }

    // Default deny (also covers the legacy compat-SDK `<app>_documents` collections)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
