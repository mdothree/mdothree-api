# mdothree-api — Firebase Cloud Functions environment variables
# Set secrets via: firebase functions:secrets:set SECRET_NAME
# Or place in functions/.env for local emulator (firebase-functions v4+)

# ---- Stripe ----
STRIPE_SECRET_KEY=sk_live_REPLACE_WITH_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_WEBHOOK_SIGNING_SECRET
STRIPE_PRICE_MONTHLY=price_REPLACE_WITH_MONTHLY_PRICE_ID
STRIPE_PRICE_YEARLY=price_REPLACE_WITH_YEARLY_PRICE_ID

# ---- HaveIBeenPwned ----
HIBP_API_KEY=REPLACE_WITH_HIBP_API_KEY

# ---- Rate limiting ----
RATE_LIMIT_PER_MINUTE=60
